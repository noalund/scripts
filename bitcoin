#!/bin/bash

# cache out 1BTC value in case of temporary curl failures:

CACHE="$HOME/.cache/bitcoin-cache"
mkdir -p "$HOME/.cache"

OUT=$(curl -s --max-time 3 rate.sx/1BTC)

if [[ -n "$OUT" ]]; then
    awk '{printf "₿%.2f", $1}' <<< "$OUT" > "$CACHE"
fi

TEXT=$(cat "$CACHE" 2>/dev/null || echo "?")
TIME=$(date -r "$CACHE" '+%H:%M (%m-%d)' 2>/dev/null || echo "unknown")

printf '{"text":"%s","tooltip":"last updated: %s"}\n' \
    "$TEXT" "$TIME"
